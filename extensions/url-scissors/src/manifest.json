{
  "manifest_version": 3,
  "name": "URL Scissors",
  "description": "Edit, add, remove and re-apply URL query parameters of the current tab — without the popup closing.",
  "version": "0.1.0",
  "minimum_chrome_version": "123",
  "action": {
    "default_popup": "popup.html",
    "default_title": "URL Scissors (Alt+Shift+U)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Open URL Scissors"
    }
  },
  "permissions": ["activeTab", "storage"]
}
