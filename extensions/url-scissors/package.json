{
  "name": "url-scissors",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: edit and re-apply URL query parameters without the popup closing.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node --test test/model.test.js",
    "bench:func": "node bench/run.js func",
    "bench:open": "BENCH_VARIANTS=pinned node bench/run.js open 30",
    "bench:runtime": "node bench/run.js runtime 4",
    "bench:video": "node bench/video.js 8 100",
    "bench:shots": "node bench/shots.js screenshots",
    "zip": "rm -f url-scissors.zip && cd src && zip -r -q ../url-scissors.zip . -x 'icons/icon.svg'"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
